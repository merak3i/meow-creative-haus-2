# Switch canonical metadata, robots, sitemap, and llms files only after the
# custom domain resolves and is attached to the production deployment.
NEXT_PUBLIC_SITE_URL=https://meowcreativehouse.xyz

# Google Analytics 4 web stream measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Verification tokens supplied by Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
